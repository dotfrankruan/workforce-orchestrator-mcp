{
  "name": "workforce-orchestrator-mcp",
  "version": "5.1.0",
  "description": "Universal MCP orchestrator that lets Codex delegate coding/research/data/docs/file/ops/review tasks to pluggable runtime backends (DeepSeek Harness, OpenCode) or direct OpenAI/Anthropic APIs",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "workforce-mcp": "./dist/cli.js",
    "workforce-orchestrator-mcp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:unit": "npm run build && node --test \"dist/test/unit/*.test.js\"",
    "test:integration": "npm run build && node --test \"dist/test/integration/*.test.js\"",
    "serve": "node dist/cli.js serve",
    "smoke": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dotfrankruan/workforce-orchestrator-mcp.git"
  },
  "homepage": "https://github.com/dotfrankruan/workforce-orchestrator-mcp"
}
